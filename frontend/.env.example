# Frontend build settings (set these in Vercel's project settings, not in a committed .env).

# Show one-click demo logins on the login page. Only for the public demo site.
VITE_DEMO_MODE=false

# Where the API lives. Leave unset: the app calls /api, which Vite (in development)
# and vercel.json (in production) forward to the backend.
# VITE_API_URL=
