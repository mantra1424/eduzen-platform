# Copy this file to .env and change the values. Never commit .env.

# Postgres (used by docker-compose and the backend)
POSTGRES_USER=eduzen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eduzen
POSTGRES_PORT=5433

# Backend
DATABASE_URL=postgresql+psycopg://eduzen:change-me@localhost:5433/eduzen
TEST_DATABASE_URL=postgresql+psycopg://eduzen:change-me@localhost:5433/eduzen_test

# Login tokens. Generate a secret with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
